    'household_id': hh_ids,
    'display_name': [f"User_{i}" for i in range(1, num_households + 1)],
    'age_band': np.random.choice(age_bands, num_households, p=age_probs),
    'gender': np.random.choice(genders, num_households, p=gender_probs),
    'persona_codes': np.random.choice(personas, num_households),
    'is_primary_user': ['Yes']*num_households,
    'onboarding_depth': ['Full']*num_households,
    'consent_personalization': ['Yes']*num_households,
    'profile_updated_at': pd.Timestamp('2026-08-01')
})

# 3. Generate DATA_food_preferences
print("Generating Food Preferences...")
prefs_df = pd.DataFrame({
    'preference_id': [f"PREF{str(i).zfill(5)}" for i in range(1, num_households + 1)],
    'household_id': hh_ids,
    'member_id': ['']*num_households,
    'diet_pattern': np.random.choice(diet_patterns, num_households, p=[0.55, 0.35, 0.05, 0.03, 0.02]),
    'fasting_patterns': np.random.choice(['None', 'Thursdays', 'Ekadashi', 'Navratri'], num_households, p=[0.7, 0.1, 0.1, 0.1]),
    'spice_level': np.random.choice(['Low', 'Medium', 'High'], num_households, p=[0.2, 0.5, 0.3]),
    'sweetness_level': np.random.choice(['Low', 'Medium', 'High'], num_households, p=[0.4, 0.4, 0.2]),
    'oil_level': np.random.choice(['Low', 'Medium', 'High'], num_households, p=[0.5, 0.4, 0.1]),
    'texture_preference': ['Balanced']*num_households,
    'home_cooked_days_week': np.random.randint(3, 8, num_households),
    'eat_out_meals_week': np.random.randint(0, 4, num_households),
    'delivery_meals_week': np.random.randint(0, 5, num_households),
    'comfort_dish_ids': ['Dal Rice' if i % 2 == 0 else 'Curd Rice' for i in range(num_households)]
})

# 4. Generate DATA_meal_history (3 meals for 5000 users = 15000 rows)
print("Generating Meal History...")
meal_events = []
event_id = 1

# Map region for fast lookup
region_map = dict(zip(states, regions))

for idx in range(num_households):
    hh_id = hh_ids[idx]
    orig_state = households_df['origin_state_ids'].iloc[idx]
    reg = region_map.get(orig_state, 'North')

    for slot in ['Breakfast', 'Lunch', 'Dinner']:
        dish_pool = dishes_by_region[reg][slot]
        dish = random.choice(dish_pool)

        meal_events.append({
            'meal_event_id': f"ME{str(event_id).zfill(6)}",
            'household_id': hh_id,
            'meal_date': '2026-08-01',
            'meal_slot': slot,
            'dish_raw_name': dish,
