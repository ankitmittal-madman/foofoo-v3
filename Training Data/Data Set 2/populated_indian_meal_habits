import pandas as pd
import numpy as np
import random
from openpyxl import load_workbook
import string

print("Starting generation...")
np.random.seed(42)
num_households = 5000

# Metadata lists
cities = ['Mumbai', 'Delhi', 'Bengaluru', 'Chennai', 'Kolkata', 'Hyderabad', 'Pune', 'Ahmedabad', 'Lucknow', 'Jaipur']
states = ['Maharashtra', 'Delhi', 'Karnataka', 'Tamil Nadu', 'West Bengal', 'Telangana', 'Maharashtra', 'Gujarat', 'Uttar Pradesh', 'Rajasthan']
