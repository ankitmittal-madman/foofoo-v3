living_setups = ['Nuclear Family', 'Joint Family', 'Working Couple', 'Single Professional', 'Roommates']
living_probs = [0.45, 0.25, 0.15, 0.10, 0.05]

decision_models = ['Unilateral', 'Consensus', 'Rotational', 'Split by Meal']
age_bands = ['18-24', '25-34', '35-44', '45-54', '55+']
age_probs = [0.15, 0.40, 0.25, 0.15, 0.05]

genders = ['M', 'F', 'O']
gender_probs = [0.48, 0.48, 0.04]

personas = ['Health_Nut', 'Comfort_Seeker', 'Traditionalist', 'Quick_Cook', 'Experimental', 'Budget_Conscious']
diet_patterns = ['Vegetarian', 'Non-Vegetarian', 'Eggetarian', 'Vegan', 'Jain']

dishes_by_region = {
    'North': {
        'Breakfast': ['Aloo Paratha', 'Poha', 'Chole Bhature', 'Besan Chilla', 'Ajwain Paratha'],
        'Lunch': ['Rajma Chawal', 'Dal Makhani & Roti', 'Paneer Butter Masala', 'Kadhi Pakora', 'Chicken Curry & Roti'],
        'Dinner': ['Dal Tadka & Phulka', 'Khichdi', 'Palak Paneer', 'Mutton Rogan Josh', 'Mixed Veg & Roti']
    },
    'South': {
        'Breakfast': ['Idli Sambar', 'Masala Dosa', 'Upma', 'Appam', 'Pesarattu'],
        'Lunch': ['Rice & Sambar', 'Lemon Rice', 'Chicken Chettinad', 'Curd Rice', 'Bisi Bele Bath'],
        'Dinner': ['Dosa', 'Rasam Rice', 'Malabar Fish Curry', 'Chapati & Kurma', 'Idiyappam']
    },
    'West': {
        'Breakfast': ['Kanda Poha', 'Thepla', 'Dhokla', 'Misal Pav', 'Fafda Jalebi'],
        'Lunch': ['Gujarati Thali', 'Dal Dhokli', 'Varan Bhaat', 'Goan Fish Curry', 'Pav Bhaji'],
        'Dinner': ['Bhakri & Pithla', 'Sev Tomato Shaak', 'Khichdi Kadhi', 'Chicken Xacuti', 'Vangyache Bharit']
    },
    'East': {
        'Breakfast': ['Luchi Aloo Dum', 'Chira Bhaja', 'Sattu Paratha', 'Ghugni', 'Kachori'],
        'Lunch': ['Machher Jhol & Rice', 'Shukto', 'Kosha Mangsho', 'Dalma', 'Chhenagaja'],
        'Dinner': ['Roti & Sabzi', 'Fish Paturi', 'Aloo Posto', 'Chicken Bharta', 'Muri Ghonto']
    }
}

# 1. Generate DATA_households
print("Generating Households...")
hh_ids = [f"HH{str(i).zfill(5)}" for i in range(1, num_households + 1)]
city_choices = np.random.choice(range(len(cities)), num_households)

setups = np.random.choice(living_setups, num_households, p=living_probs)
hh_sizes = []
adult_counts = []
child_counts = []
elder_counts = []

for setup in setups:
    if setup == 'Nuclear Family':
        a, c, e = 2, random.randint(1,2), 0
    elif setup == 'Joint Family':
        a, c, e = random.randint(3,5), random.randint(1,3), random.randint(1,2)
    elif setup == 'Working Couple':
        a, c, e = 2, 0, 0
    elif setup == 'Single Professional':
        a, c, e = 1, 0, 0
    else: # Roommates
        a, c, e = random.randint(2,4), 0, 0
    adult_counts.append(a)
    child_counts.append(c)
    elder_counts.append(e)
    hh_sizes.append(a + c + e)

households_df = pd.DataFrame({
    'household_id': hh_ids,
    'household_name': [f"Family_{random.randint(100,999)}" for _ in range(num_households)],
    'current_city_id': [cities[i] for i in city_choices],
    'current_state_id': [states[i] for i in city_choices],
