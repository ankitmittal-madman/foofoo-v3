ONTOLOGY_ENV=development
ONTOLOGY_DATABASE_URL=postgresql://ontology_service:change-me@localhost:5432/foofoo_ontology
ONTOLOGY_CACHE_SECONDS=300
# JSON object keyed by principal. Use secret injection, never commit real tokens.
ONTOLOGY_SERVICE_TOKENS={"foofoo-app":{"token":"change-me","scopes":["ontology:read","ontology:write"]},"ontology-admin":{"token":"change-me-too","scopes":["ontology:read","ontology:write","ontology:admin"]}}
