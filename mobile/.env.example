# Supabase project connection — no live project ref exists in this repo yet (confirmed by
# session-start audit of supabase/config.toml); fill in from the actual Supabase project when one
# is provisioned. Never commit real values here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL for the Edge Functions. Supabase's own routing convention is
# `${SUPABASE_URL}/functions/v1/<function-folder-name>` (household/index.ts, recommendations/
# index.ts) — DOC-P3-06's "/v1/household"/"/v1/recommendations" naming is the LOGICAL endpoint name,
# not a confirmed literal gateway path; no gateway/rewrite config was found in-repo to confirm a
# different literal path. Defaulting to the native Supabase convention; confirm against the actual
# deployed project before Phase 2.
EXPO_PUBLIC_API_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# Public OneSignal application identifier. The REST API key belongs only in Supabase secrets.
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
