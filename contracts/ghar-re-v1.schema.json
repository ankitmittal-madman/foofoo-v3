{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foofoo.app/contracts/ghar-re-v1.schema.json",
  "title": "Ghar RE v1 HTTP contract",
  "description": "Single source of truth for the Ghar RE v1 request/response contract (RE-DOC-10 §5/§6, RE-DOC-11 §5/§6). Both the Python RE and the Edge Function validate against this file. Validate a request against $defs/RecommendationRequest and a response against $defs/RecommendationResponse.",
  "x-contract-version": "v1",
  "x-compatibility-rules": {
    "note": "COMPATIBILITY CONTRACT (RE-DOC-11 §5) — enforced, not just documented. The additive/open-field tolerance below is asserted by ghar_re_service/tests/test_contract.py; do not tighten `additionalProperties` to false without a /v2.",
    "rules": [
      "1. Additive/open mode: unknown fields MUST be ignored by consumers, never rejected. Every object here sets additionalProperties:true for exactly this reason.",
      "2. New fields are ALWAYS optional and carry a sensible default assumed by older clients; never add a required field within v1.",
      "3. NEVER repurpose or change the meaning/type of an existing field — add a new field and deprecate the old one over a documented window.",
      "4. Only a genuinely breaking change (removing a field, changing a type, changing meaning) bumps the URL to /v2/; both versions run concurrently during migration."
    ]
  },
  "$defs": {
    "MetaField": {
      "description": "A derived θ field with provenance (D1-D7 §1.1). Shown for reference/explainability; the request carries RAW Q1-Q15, not this.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string" }
      }
    },

    "MemberAge": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": { "type": "string", "description": "self/adult/child/teen/senior/toddler/weaning" },
        "age": { "type": "integer", "minimum": 0 }
      },
      "required": ["age"]
    },

    "HouseholdRaw": {
      "description": "Raw Q1-Q15 onboarding answers. The RE runs D1-D7 itself (frozen decision: recommendation mathematics live exclusively inside the RE), so the caller sends raw inputs, NOT pre-derived θ.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string" },
        "q1_household_type": {
          "type": "string",
          "enum": ["single", "couple", "couple_kids", "couple_kids_parents", "joint", "flatmates"]
        },
        "q2_working_professionals": { "type": "integer", "minimum": 0 },
        "q3_home_state": { "type": "string" },
        "q4_current_city": { "type": "string" },
        "q5_diet": { "type": "string", "enum": ["veg", "eggetarian", "non_veg", "vegan"] },
        "q6_nonveg_types": { "type": "array", "items": { "type": "string" } },
        "q7_veg_days": { "type": "array", "items": { "type": "string" } },
        "q8_is_jain": { "type": "boolean" },
        "q9_allergies": { "type": "array", "items": { "type": "string" } },
        "q10_allergy_other": { "type": ["string", "null"] },
        "q11_conditions": { "type": "array", "items": { "type": "string" } },
        "q12_member_ages": { "type": "array", "items": { "$ref": "#/$defs/MemberAge" } },
        "q13_who_cooks": { "type": "string", "enum": ["self", "family", "hired_cook", "order_tiffin"] },
        "q14_eat_out_per_week": { "type": "integer", "minimum": 0 },
        "q15_objective": {
          "type": "string",
          "enum": ["awesome_taste", "healthy_living", "into_fitness", "protein_calculator"]
        }
      },
      "required": [
        "q1_household_type", "q2_working_professionals", "q3_home_state", "q4_current_city",
        "q5_diet", "q8_is_jain", "q12_member_ages", "q13_who_cooks", "q15_objective"
      ]
    },

    "Weather": {
      "description": "Mocked/injected weather (no live API in v1). is_raining / temp_c drive the transient m_weather term.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "is_raining": { "type": "boolean" },
        "temp_c": { "type": ["number", "null"] },
        "weather_condition": { "type": ["string", "null"], "description": "rain/heatwave/cold_snap/clear" },
        "humidity": { "type": ["number", "null"] }
      }
    },

    "HouseholdContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "slot": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snacks"] },
        "date": { "type": "string", "description": "ISO date; season derivable from it if season omitted" },
        "weekday": { "type": "string" },
        "season": { "type": "string", "enum": ["summer", "monsoon", "winter", "transitional", "post_monsoon"] },
        "weather": { "$ref": "#/$defs/Weather" },
        "active_modes": { "type": "array", "items": { "type": "string", "enum": ["fasting", "festival", "veg_egg"] } },
        "calorie_target": { "type": ["integer", "null"] },
        "interaction_count": { "type": "integer", "minimum": 0, "description": "Total explicit user feedback rows recorded for this household (automatic shown_not_tapped impressions excluded). Drives cohort-decay terms; absent is treated as 0." },
        "novelty_budget": { "type": "number", "minimum": 0, "maximum": 1, "description": "Persisted exploration budget derived from repeated recent exposures; used only by post-eligibility diversity reranking." },
        "richness_debt": { "type": "number", "minimum": 0, "maximum": 1, "description": "Observed excess recent richness above the neutral midpoint; used only to tighten the visible rich-dish cap." }
      },
      "required": ["slot"]
    },

    "RecommendationRequest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "request_id": { "type": "string", "description": "UUID; if omitted the service generates one and echoes it back." },
        "household": { "$ref": "#/$defs/HouseholdRaw" },
        "context": { "$ref": "#/$defs/HouseholdContext" },
        "include_decision_trace": { "type": "boolean", "description": "Optional, defaults to false. When true, the response includes decision_trace: the funnel of how many catalogue dishes survived each hard filter (diet/jain/allergen/weaning/fasting), the served plates ranked, and the top near-miss alternatives with why each lost." },
        "exclude_dish_ids": { "type": "array", "items": { "type": "string" }, "description": "WP-8G Option A ('Recommendation Variety on Refresh'). Optional, additive; empty/omitted is a no-op. Dish ids the RE must hard-filter out of the candidate pool BEFORE scoring/selection (never a scoring penalty) — typically the household's own last-served dish ids, so a refresh doesn't repeat them." },
        "exclude_dish_names": { "type": "array", "items": { "type": "string" }, "description": "Canonical names or aliases suppressed from this response, normally from recent exposure or explicit Not Today/Never feedback." },
        "preference_by_dish": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Bounded online dish affinities. Exact explicit feedback remains authoritative." },
        "preference_by_class": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Bounded meal-class affinities derived from explicit feedback and mapping confidence." },
        "preference_by_tag": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Bounded semantic affinities keyed as dimension:tag_name; used to generalize feedback to unseen dishes." }
      },
      "required": ["household", "context"]
    },

    "Contribution": {
      "description": "One scoring module's contribution to a plate's BASE (RE-DOC-11 §6/§7). The list is OPEN: a new scoring module appends one entry; nothing upstream changes. Do NOT convert this back into fixed named fields.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "module": { "type": "string", "description": "e.g. m_palette, m_weather, sig, prior_boost, s_pref" },
        "value": { "type": "number", "description": "the module's raw m_k(x) output" },
        "weight": { "type": "number", "description": "W_k · conf_k applied to value" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["module", "value", "weight", "confidence"]
    },

    "Plate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plate_id": { "type": "string" },
        "form": { "type": "string", "enum": ["pair", "single", "standalone"] },
        "hero_dish_ids": { "type": "array", "items": { "type": "string" }, "description": "1 (single/standalone) or 2 (pair) hero dish ids" },
        "hero_dish_names": { "type": "array", "items": { "type": "string" } },
        "support": { "type": ["string", "null"], "description": "editable default carb from {Roti,Paratha,Poori,Rice}; null for standalone" },
        "is_standalone": { "type": "boolean" },
        "plate_score": { "type": "number" },
        "base_total": { "type": "number", "description": "FIXED aggregate: Σ of contributions (before Q15 gain)" },
        "gain_multiplier": { "type": "number", "description": "FIXED aggregate: GAIN_Q15 multiplier" },
        "final_score": { "type": "number", "description": "FIXED aggregate: the plate's final rank score" },
        "contributions": { "type": "array", "items": { "$ref": "#/$defs/Contribution" } }
      },
      "required": ["plate_id", "form", "hero_dish_ids", "plate_score", "base_total", "gain_multiplier", "final_score", "contributions"]
    },

    "RecommendationResponse": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "request_id": { "type": "string" },
        "api_version": { "type": "string", "const": "v1" },
        "engine_version": { "type": "string" },
        "config_version": { "type": "string" },
        "plates": { "type": "array", "items": { "$ref": "#/$defs/Plate" } },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal notes (e.g. 'only 5 of 7 plates could be formed'). Partial results are a valid 200, not an error (RE-DOC-10 §11)."
        },
        "decision_trace": {
          "type": "object",
          "additionalProperties": true,
          "description": "Present only when the request set include_decision_trace=true. Per-request explainability: funnel[] (ordered {stage, count} dish-survival counts through the hard filters), winners[] (the served plates, ranked), alternatives_considered[] (top near-misses with why_it_lost), and a plain-English reasoning string. Additive/open shape (RE-DOC-11 §6) — not further typed here."
        }
      },
      "required": ["request_id", "api_version", "engine_version", "config_version", "plates", "warnings"]
    },

    "MealEpisodeRequest": {
      "description": "Canonical request for the complete-meal episode decision surface.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "request_id": { "type": "string" },
        "household": { "$ref": "#/$defs/HouseholdRaw" },
        "context": { "$ref": "#/$defs/HouseholdContext" },
        "count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "class_code": { "type": ["string", "null"] },
        "exclude_dish_names": { "type": "array", "items": { "type": "string" } },
        "preference_by_dish": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "preference_by_class": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "preference_by_tag": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "required": ["household", "context"]
    },

    "EpisodeComponent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dish_id": { "type": ["string", "null"] },
        "dish_name": { "type": "string" },
        "component_role": { "type": "string" },
        "grammar_role": { "type": "string", "enum": ["primary", "side"] },
        "is_required": { "type": "boolean" },
        "image_url": { "type": ["string", "null"] }
      },
      "required": ["dish_id", "dish_name", "component_role", "grammar_role", "is_required"]
    },

    "EpisodePracticality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "active_minutes": { "type": "integer", "minimum": 0 },
        "critical_path_minutes": { "type": "integer", "minimum": 0 },
        "vessel_count": { "type": "integer", "minimum": 0 },
        "burner_peak": { "type": "integer", "minimum": 0 },
        "ingredient_count": { "type": "integer", "minimum": 0 },
        "complex_method_count": { "type": "integer", "minimum": 0 },
        "pantry_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "feature_version": { "type": "string" },
        "estimation_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["active_minutes", "critical_path_minutes", "vessel_count", "burner_peak", "ingredient_count", "feature_version", "estimation_confidence"]
    },

    "EpisodePrediction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "p_choose": { "type": "number", "minimum": 0, "maximum": 1 },
        "p_execute": { "type": "number", "minimum": 0, "maximum": 1 },
        "p_regret": { "type": "number", "minimum": 0, "maximum": 1 },
        "p_success": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_version": { "type": "string" },
        "calibration_status": { "type": "string" }
      },
      "required": ["p_choose", "p_execute", "p_regret", "p_success", "model_version", "calibration_status"]
    },

    "MealEpisode": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "episode_hash": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "grammar_code": { "type": "string" },
        "grammar_version": { "type": "integer", "minimum": 1 },
        "plate_form": { "type": "string", "enum": ["pair", "single", "standalone"] },
        "display_name": { "type": "string" },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EpisodeComponent" } },
        "intent": { "type": "string" },
        "intent_posterior": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "practicality": { "$ref": "#/$defs/EpisodePracticality" },
        "cadence_tier": { "type": "string", "enum": ["daily_staple", "regular_rotation", "weekly_rich", "occasional", "festive"] },
        "richness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "predictions": { "$ref": "#/$defs/EpisodePrediction" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "source_plate_score": { "type": "number" }
      },
      "required": ["episode_hash", "rank", "grammar_code", "grammar_version", "plate_form", "display_name", "components", "intent", "intent_posterior", "practicality", "cadence_tier", "richness_score", "predictions", "reasons", "source_plate_score"]
    },

    "MealEpisodeSlateResponse": {
      "description": "Canonical complete-meal episode slate returned by POST /v1/meal-episodes.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "request_id": { "type": "string" },
        "kind": { "type": "string", "const": "meal_episode_slate" },
        "slot": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snacks"] },
        "episodes": { "type": "array", "items": { "$ref": "#/$defs/MealEpisode" } },
        "eligible_episode_hashes": { "type": "array", "items": { "type": "string" } },
        "policy_code": { "type": "string" },
        "model_version": { "type": "string" },
        "config_version": { "type": "string" },
        "catalog_version": { "type": ["string", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["request_id", "kind", "slot", "episodes", "eligible_episode_hashes", "policy_code", "model_version", "config_version", "warnings"]
    },

    "MetaResponse": {
      "description": "GET /v1/meta — versions only, no request-specific data.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "api_version": { "type": "string", "const": "v1" },
        "engine_version": { "type": "string" },
        "config_version": { "type": "string" }
      },
      "required": ["api_version", "engine_version", "config_version"]
    }
  }
}
