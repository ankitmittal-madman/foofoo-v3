AUX_REC_ENABLED=false
AUX_REC_MODE=shadow
AUX_REC_MIN_DELTA=0.05
AUX_REC_MIN_CONFIDENCE=0.55
AUX_REC_REQUIRE_CONSTRAINT_PASS=true
AUX_REC_USE_LOCAL_RERANKER=true
AUX_REC_LOG_ALL=true
AUX_REC_ALLOW_OVERRIDE=false
# Optional local services/artifacts only:
AUX_REC_QDRANT_URL=http://qdrant:6333
AUX_REC_QDRANT_COLLECTION=foofoo_recipes
AUX_REC_CANDIDATE_POOL_PATH=/srv/aux-re/candidates.json
AUX_REC_MODEL_ARTIFACT_DIR=/srv/aux-re/models
AUX_REC_KNOWLEDGE_GRAPH_PATH=/srv/aux-re/knowledge_graph.json
AUX_REC_RETRIEVAL_TIMEOUT_SECONDS=1.5
# Independent switches for implemented optional model paths:
AUX_REC_MODEL_QDRANT_ENABLED=true
AUX_REC_MODEL_EMBEDDER_ENABLED=true
AUX_REC_MODEL_LIGHTFM_ENABLED=false
AUX_REC_LIGHTFM_ARTIFACT_PATH=/srv/aux-re/models/lightfm_v1.joblib
AUX_REC_LIGHTFM_WEIGHT=0.35
# Synthetic artifacts are blocked by default. Enable only for local/shadow verification.
AUX_REC_LIGHTFM_ALLOW_SYNTHETIC=false
AUX_REC_LIGHTFM_ALLOW_UNPROMOTED=false
