{
  "expo": {
    "name": "FooFoo",
    "slug": "foofoo-mobile",
    "scheme": "foofoo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.foofoo.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.app.foofoo.mobile.onesignal"
        ]
      }
    },
    "android": {
      "package": "app.foofoo.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "app.foofoo.mobile.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.foofoo.mobile.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3fccc5fc-bf6e-4d37-b14f-9c0bba021d95"
      }
    },
    "owner": "apverse-labs"
  }
}
