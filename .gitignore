# macOS Finder metadata — never belongs in the repository (removed from tracking 2026-07-13)
.DS_Store

# Local secrets — database connection strings / credentials. NEVER commit. (WP-6E.2)
.env
.env.*
!.env.example

# Hook-generated log — noise, not source (session-knowledge-doc skill)
.claude/hooks/knowledge-book-warnings.log

# Transient git worktrees created for isolated background agents — each is a
# full working copy with its own .git link, never a real repo change
.claude/worktrees/

# Python bytecode (ghar_re_core + ghar_re_service)
__pycache__/
*.pyc
.pytest_cache/

# Python packaging build artifacts (editable installs)
*.egg-info/
build/
dist/

# ops/quality — ignore future timestamped quality-report runs and the latest pointer,
# but the module itself and any explicitly-added sample report stay tracked.
ops/quality/reports/*/
!ops/quality/reports/2026-08-03_062119/
ops/quality/reports/latest.txt

# Supabase CLI local link/cache state — machine-local, no secrets (project ref/name/org only),
# regenerated by `supabase link` / any CLI command. Never meant to be shared via git.
supabase/.temp/
supabase/.branches/

# Claude Code local permission overrides — personal to this machine/session, never shared via git.
.claude/settings.local.json

# npm-installed dependency trees — regenerated via `npm install`, never checked in.
node_modules/
